# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/mindhaven?schema=public"

# JWT Secret (Mandatory: Must be configured; app will throw at startup if missing)
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# AI Configuration (Empathetic AI Companion & Mood Insights)
OPENROUTER_API_KEY=""
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# 100ms Video/Audio Telemedicine Real-Time Cloud
# Obtain from https://dashboard.100ms.live/ -> Developer Settings
# Create a Template named 'telehealth' with two roles: 'host' (practitioner) and 'guest' (patient)
HMS_APP_ACCESS_KEY=""
HMS_APP_SECRET=""
HMS_TEMPLATE_ID=""
HMS_WEBHOOK_SECRET=""

# Razorpay Payment Gateway (Paise-based transactions)
# Obtain from https://dashboard.razorpay.com/ -> Settings -> API Keys
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Real-time WebSockets / Pusher Channels
# Obtain from https://dashboard.pusher.com/ -> Create Channels App -> App Keys
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="ap2"
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="ap2"

# Resend Email Configuration (For appointment reminders)
RESEND_API_KEY=""

# Cron Secret for Vercel Cron or External Scheduled Jobs
CRON_SECRET=""

# Google OAuth Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Demo Data Seed ─────────────────────────────────────────────────────────────
# Default password for all demo accounts (demo.user@demo.mindhaven.local etc.)
# Change this to any value you like; it only affects seeded demo accounts.
DEMO_PASSWORD="Demo@12345"

# Safety guard: set to "true" to allow running the demo seed in production.
# Leave blank in production unless you absolutely know what you're doing.
ALLOW_DEMO_SEED=""
